# Optional overrides for `docker compose` (copy to .env; never commit .env).
# The defaults below are for local development only.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DB_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=5173
RUN_SEED=true

# Optional: override only when the app is served from another host (the defaults follow the ports above).
# CORS_ORIGIN=http://localhost:5173
# VITE_API_BASE_URL=http://localhost:3000/api/v1
